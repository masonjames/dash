# Configure each process independently. Values below are placeholders only.
# API reader and indexer: OpenAI query/document embeddings.
OPENAI_API_KEY=

# Private API reader: all five required; no fallback to DB_*.
OPS_DB_HOST=
OPS_DB_PORT=5432
OPS_DB_USER=dash_ops_reader
OPS_DB_PASS=
OPS_DB_DATABASE=

# Shared by Dockhand and the private API (minimum 32 characters).
DASH_INTERNAL_API_SECRET=
# DASH_OPS_INDEX_MAX_AGE_SECONDS=7200
# Optional returned detector-version label; omit to use the built-in version.
# DASH_OPS_MODEL_VERSION=

# Separate indexer process: all five required; no DB_* or OPS_DB_* fallback.
# Can read canonical records and mutate only retrieval documents/status.
OPS_INDEXER_DB_HOST=
OPS_INDEXER_DB_PORT=5432
OPS_INDEXER_DB_USER=dash_ops_indexer
OPS_INDEXER_DB_PASS=
OPS_INDEXER_DB_DATABASE=

# Migration process ONLY: owner connection and provisioned runtime passwords.
# Never pass owner/writer passwords to the API or indexer.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_DATABASE=
# Each role password must contain at least 16 characters.
DASH_OPS_READER_PASSWORD=
DASH_OPS_INDEXER_PASSWORD=
DOCKHAND_OPS_WRITER_PASSWORD=
DASH_API_RUNTIME_PASSWORD=
