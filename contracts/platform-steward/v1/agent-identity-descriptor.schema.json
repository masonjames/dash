{
  "$defs": {
    "boundedString": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "maximum_calls": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_cost_microunits": {
          "maximum": 1000000000000,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximum_calls",
        "maximum_cost_microunits",
        "maximum_tokens"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "evaluationGate": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "$ref": "#/$defs/digest"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "ambiguous"
          ]
        }
      },
      "required": [
        "name",
        "status",
        "evidence_hash"
      ],
      "type": "object"
    },
    "evidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "$ref": "#/$defs/digest"
        },
        "observed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "source_domain": {
          "enum": [
            "platform-operations",
            "platform-engineering",
            "synthetic",
            "replay"
          ]
        },
        "source_kind": {
          "enum": [
            "fixture",
            "observation",
            "repository",
            "release",
            "lifecycle",
            "human_review",
            "evaluation"
          ]
        },
        "source_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "trust_state": {
          "enum": [
            "untrusted",
            "cited",
            "verified"
          ]
        }
      },
      "required": [
        "evidence_hash",
        "source_kind",
        "source_ref",
        "source_domain",
        "observed_at",
        "trust_state"
      ],
      "type": "object"
    },
    "humanReview": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "evidence_hash": {
                "$ref": "#/$defs/digest"
              },
              "provenance_state": {
                "const": "externally-authenticated"
              },
              "reviewed_at": {
                "$ref": "#/$defs/utcTimestamp"
              },
              "reviewer_key_id": {
                "$ref": "#/$defs/identifier"
              },
              "signature_bundle_hash": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "if": {
            "properties": {
              "decision": {
                "const": "pending"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "evidence_hash": {
                "type": "null"
              },
              "provenance_state": {
                "const": "pending-unsigned"
              },
              "reviewed_at": {
                "type": "null"
              },
              "reviewer_key_id": {
                "type": "null"
              },
              "signature_bundle_hash": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "evidence_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance_state": {
          "enum": [
            "pending-unsigned",
            "externally-authenticated"
          ]
        },
        "review_id": {
          "$ref": "#/$defs/uuid"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/identifier"
        },
        "reviewer_key_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature_bundle_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "review_id",
        "reviewer",
        "reviewer_key_id",
        "signature_bundle_hash",
        "provenance_state",
        "decision",
        "reviewed_at",
        "evidence_hash"
      ],
      "type": "object"
    },
    "identifier": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
      "type": "string"
    },
    "identityBinding": {
      "additionalProperties": false,
      "properties": {
        "identity_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "identity_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "identity_id",
        "identity_revision",
        "identity_epoch"
      ],
      "type": "object"
    },
    "modelProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_digest": {
          "$ref": "#/$defs/digest"
        },
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "adapter_digest"
      ],
      "type": "object"
    },
    "overlaySelection": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "overlay_selection_digest": {
          "$ref": "#/$defs/digest"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "release_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "release_id": {
          "$ref": "#/$defs/identifier"
        },
        "selected_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "selection_evidence_hash": {
          "$ref": "#/$defs/digest"
        },
        "selection_id": {
          "$ref": "#/$defs/uuid"
        },
        "selector": {
          "$ref": "#/$defs/identifier"
        },
        "selector_key_id": {
          "$ref": "#/$defs/identifier"
        },
        "signature_bundle_hash": {
          "$ref": "#/$defs/digest"
        },
        "signed_release_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "selection_id",
        "signed_release_digest",
        "release_binding_digest",
        "release_id",
        "capability_id",
        "package_digest",
        "profile_digest",
        "overlay_selection_digest",
        "selected_at",
        "selector",
        "selector_key_id",
        "signature_bundle_hash",
        "selection_evidence_hash"
      ],
      "type": "object"
    },
    "providerValidation": {
      "additionalProperties": false,
      "properties": {
        "attestation_hash": {
          "$ref": "#/$defs/digest"
        },
        "lease_hash": {
          "$ref": "#/$defs/digest"
        },
        "phase": {
          "enum": [
            "entry",
            "before_return"
          ]
        },
        "result": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "validated_at": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "required": [
        "phase",
        "validated_at",
        "lease_hash",
        "attestation_hash",
        "result"
      ],
      "type": "object"
    },
    "releaseBinding": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "interface_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "overlay_selection_digest": {
          "$ref": "#/$defs/digest"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "release_id": {
          "$ref": "#/$defs/identifier"
        },
        "signature_bundle_hash": {
          "$ref": "#/$defs/digest"
        },
        "signer_key_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "release_id",
        "capability_id",
        "package_digest",
        "interface_schema_digest",
        "profile_digest",
        "overlay_selection_digest",
        "signer_key_id",
        "signature_bundle_hash"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_type": {
          "$ref": "#/$defs/identifier"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "scope_type",
        "scope_id",
        "installation_id",
        "resource_type",
        "resource_id"
      ],
      "type": "object"
    },
    "settledUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "const": 1
        },
        "cost_microunits": {
          "maximum": 1000000000000,
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "tokens",
        "cost_microunits"
      ],
      "type": "object"
    },
    "signedRelease": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_hash": {
          "$ref": "#/$defs/digest"
        },
        "release": {
          "$ref": "#/$defs/releaseBinding"
        },
        "signed_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "signing_evidence_hash": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "manifest_hash",
        "artifact_digest",
        "release",
        "signed_at",
        "signing_evidence_hash"
      ],
      "type": "object"
    },
    "supportedInstallation": {
      "additionalProperties": false,
      "properties": {
        "admission_state": {
          "enum": [
            "designated",
            "admitted",
            "retired"
          ]
        },
        "broker_mode": {
          "enum": [
            "none",
            "human-present"
          ]
        },
        "embodiment": {
          "enum": [
            "server-sentinel",
            "mac-engineer"
          ]
        },
        "host_class": {
          "enum": [
            "near-platform-server",
            "local-mac"
          ]
        },
        "host_label": {
          "$ref": "#/$defs/boundedString"
        },
        "installation_id": {
          "$ref": "#/$defs/identifier"
        },
        "runtime_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "installation_id",
        "embodiment",
        "host_label",
        "host_class",
        "admission_state",
        "runtime_enabled",
        "broker_mode"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.masonjames.dev/platform-steward/v1/agent-identity-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "signature_bundle_hash": {
            "$ref": "#/$defs/digest"
          },
          "signer_key_id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "enum": [
              "active",
              "revoked",
              "retired"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "provenance_state": {
            "const": "pending-unsigned"
          }
        },
        "required": [
          "provenance_state"
        ]
      },
      "then": {
        "properties": {
          "signature_bundle_hash": {
            "type": "null"
          },
          "signer_key_id": {
            "type": "null"
          },
          "status": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_id": {
            "const": "platform-steward"
          }
        },
        "required": [
          "identity_id"
        ]
      },
      "then": {
        "properties": {
          "logical_name": {
            "const": "platform-steward"
          },
          "maximum_authority_mode": {
            "const": "intent"
          },
          "permitted_embodiments": {
            "const": [
              "server-sentinel",
              "mac-engineer"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "logical_name": {
            "const": "platform-steward"
          }
        },
        "required": [
          "logical_name"
        ]
      },
      "then": {
        "properties": {
          "identity_id": {
            "const": "platform-steward"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_id": {
            "const": "platform-foundry-evaluator"
          }
        },
        "required": [
          "identity_id"
        ]
      },
      "then": {
        "properties": {
          "logical_name": {
            "const": "platform-foundry-evaluator"
          },
          "maximum_authority_mode": {
            "const": "read"
          },
          "permitted_embodiments": {
            "const": [
              "foundry-replay"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "logical_name": {
            "const": "platform-foundry-evaluator"
          }
        },
        "required": [
          "logical_name"
        ]
      },
      "then": {
        "properties": {
          "identity_id": {
            "const": "platform-foundry-evaluator"
          }
        }
      }
    }
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.masonjames.dev/steward/v1"
    },
    "constitution_hash": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "durable_store": {
      "const": "agent-chronicle"
    },
    "hash_algorithm": {
      "const": "domain-separated-canonical-json-sha256-v1"
    },
    "identity_id": {
      "$ref": "#/$defs/identifier"
    },
    "initial_identity_epoch": {
      "const": 1
    },
    "initial_identity_revision": {
      "const": 1
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "kind": {
      "const": "AgentIdentityDescriptor"
    },
    "logical_name": {
      "$ref": "#/$defs/identifier"
    },
    "maximum_authority_mode": {
      "enum": [
        "read",
        "intent"
      ]
    },
    "owner_id": {
      "$ref": "#/$defs/identifier"
    },
    "permitted_embodiments": {
      "items": {
        "enum": [
          "server-sentinel",
          "mac-engineer",
          "foundry-replay"
        ]
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "personal_memory_isolation": {
      "const": true
    },
    "provenance_state": {
      "enum": [
        "pending-unsigned",
        "externally-authenticated"
      ]
    },
    "record_hash": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/uuid"
    },
    "recorded_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "signature_bundle_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "signer_key_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pending",
        "active",
        "revoked",
        "retired"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "record_id",
    "recorded_at",
    "hash_algorithm",
    "record_hash",
    "identity_id",
    "logical_name",
    "owner_id",
    "created_at",
    "initial_identity_revision",
    "initial_identity_epoch",
    "constitution_hash",
    "durable_store",
    "permitted_embodiments",
    "maximum_authority_mode",
    "personal_memory_isolation",
    "issuer",
    "signer_key_id",
    "signature_bundle_hash",
    "provenance_state",
    "status"
  ],
  "title": "AgentIdentityDescriptor",
  "type": "object"
}
