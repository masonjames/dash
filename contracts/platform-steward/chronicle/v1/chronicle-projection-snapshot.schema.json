{
  "$defs": {
    "canonicalRecord": {
      "additionalProperties": false,
      "properties": {
        "canonical_record_json": {
          "maxLength": 1048576,
          "minLength": 2,
          "type": "string"
        },
        "record_hash": {
          "$ref": "#/$defs/digest"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "record_kind": {
          "enum": [
            "AgentConstitution",
            "AgentEpisode",
            "AgentHandoff",
            "AgentIdentityDescriptor",
            "AgentIdentityRevision",
            "CapabilityCandidate",
            "CapabilityEvaluation",
            "CapabilityGap",
            "CapabilityInvocation",
            "CapabilityLease",
            "CapabilityPromotion",
            "CapabilityRevocation",
            "FoundryAdmissionAttestation",
            "KnowledgeClaim",
            "ReasoningLease",
            "RuntimeAttestation"
          ]
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "record_hash",
        "canonical_record_json"
      ],
      "type": "object"
    },
    "capabilityBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_calls": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_cost_microunits": {
          "maximum": 1000000000000,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximum_calls",
        "maximum_cost_microunits",
        "maximum_tokens"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "constitution_hash": {
          "$ref": "#/$defs/digest"
        },
        "identity_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "identity_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "identity_id",
        "identity_revision",
        "identity_epoch",
        "constitution_hash"
      ],
      "type": "object"
    },
    "installation": {
      "additionalProperties": false,
      "properties": {
        "embodiment": {
          "enum": [
            "server-sentinel",
            "mac-engineer"
          ]
        },
        "host_class": {
          "enum": [
            "near-platform-server",
            "local-mac"
          ]
        },
        "installation_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "installation_id",
        "embodiment",
        "host_class"
      ],
      "type": "object"
    },
    "reasoningCasPrecondition": {
      "additionalProperties": false,
      "properties": {
        "expected_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "identity_id",
        "scope_type",
        "scope_id",
        "expected_generation",
        "expected_active_reasoning_lease_hash"
      ],
      "type": "object"
    },
    "reasoningCasResult": {
      "additionalProperties": false,
      "properties": {
        "committed_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "previous_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "identity_id",
        "scope_type",
        "scope_id",
        "previous_generation",
        "committed_generation",
        "previous_active_reasoning_lease_hash",
        "committed_active_reasoning_lease_hash"
      ],
      "type": "object"
    },
    "recordCommit": {
      "additionalProperties": false,
      "properties": {
        "append_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "record_hash": {
          "$ref": "#/$defs/digest"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "record_kind": {
          "enum": [
            "AgentConstitution",
            "AgentEpisode",
            "AgentHandoff",
            "AgentIdentityDescriptor",
            "AgentIdentityRevision",
            "CapabilityCandidate",
            "CapabilityEvaluation",
            "CapabilityGap",
            "CapabilityInvocation",
            "CapabilityLease",
            "CapabilityPromotion",
            "CapabilityRevocation",
            "FoundryAdmissionAttestation",
            "KnowledgeClaim",
            "ReasoningLease",
            "RuntimeAttestation"
          ]
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "record_hash",
        "append_sequence"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_type": {
          "$ref": "#/$defs/identifier"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "scope_type",
        "scope_id",
        "installation_id",
        "resource_type",
        "resource_id"
      ],
      "type": "object"
    },
    "scopeBinding": {
      "additionalProperties": false,
      "properties": {
        "record_hashes": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "runtime_attestation_hashes": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      },
      "required": [
        "scope",
        "runtime_attestation_hashes",
        "record_hashes"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.masonjames.dev/platform-steward/chronicle/v1/chronicle-projection-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "platform.masonjames.dev/steward-chronicle/v1"
    },
    "as_of": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "audience": {
      "$ref": "#/$defs/identifier"
    },
    "authority_effect": {
      "const": "none"
    },
    "chronicle_id": {
      "$ref": "#/$defs/identifier"
    },
    "chronicle_record_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "chronicle_records_digest": {
      "$ref": "#/$defs/digest"
    },
    "chronicle_watermark": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "contains_private_identity": {
      "const": false
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "generated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "installation": {
      "$ref": "#/$defs/installation"
    },
    "kind": {
      "const": "ChronicleProjectionSnapshot"
    },
    "mode": {
      "const": "read"
    },
    "previous_snapshot_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer_id": {
      "$ref": "#/$defs/identifier"
    },
    "producer_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "producer_runtime_attestation_hash": {
      "$ref": "#/$defs/digest"
    },
    "projection_canonical_json": {
      "maxLength": 4194304,
      "minLength": 2,
      "type": "string"
    },
    "projection_digest": {
      "$ref": "#/$defs/digest"
    },
    "projection_name": {
      "const": "platform-steward-audit-v1"
    },
    "projection_schema_digest": {
      "$ref": "#/$defs/digest"
    },
    "read_only": {
      "const": true
    },
    "revocation_identity": {
      "$ref": "#/$defs/identifier"
    },
    "signature_bundle_hash": {
      "$ref": "#/$defs/digest"
    },
    "snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "snapshot_id": {
      "$ref": "#/$defs/uuid"
    },
    "snapshot_nonce": {
      "$ref": "#/$defs/uuid"
    },
    "snapshot_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "source_attestation_hash": {
      "$ref": "#/$defs/digest"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_contract_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_repository": {
      "const": "https://github.com/masonjames/platform-infra"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "snapshot_id",
    "snapshot_nonce",
    "snapshot_sequence",
    "previous_snapshot_hash",
    "projection_name",
    "projection_schema_digest",
    "generated_at",
    "as_of",
    "expires_at",
    "chronicle_id",
    "chronicle_watermark",
    "chronicle_record_count",
    "chronicle_records_digest",
    "source_repository",
    "source_commit",
    "source_contract_manifest_digest",
    "projection_canonical_json",
    "projection_digest",
    "audience",
    "installation",
    "mode",
    "source_attestation_hash",
    "producer_id",
    "producer_key_id",
    "producer_runtime_attestation_hash",
    "revocation_identity",
    "authority_effect",
    "read_only",
    "contains_private_identity",
    "snapshot_digest",
    "signature_bundle_hash"
  ],
  "title": "ChronicleProjectionSnapshot",
  "type": "object"
}
