{
  "$defs": {
    "canonicalRecord": {
      "additionalProperties": false,
      "properties": {
        "canonical_record_json": {
          "maxLength": 1048576,
          "minLength": 2,
          "type": "string"
        },
        "record_hash": {
          "$ref": "#/$defs/digest"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "record_kind": {
          "enum": [
            "AgentConstitution",
            "AgentEpisode",
            "AgentHandoff",
            "AgentIdentityDescriptor",
            "AgentIdentityRevision",
            "CapabilityCandidate",
            "CapabilityEvaluation",
            "CapabilityGap",
            "CapabilityInvocation",
            "CapabilityLease",
            "CapabilityPromotion",
            "CapabilityRevocation",
            "FoundryAdmissionAttestation",
            "KnowledgeClaim",
            "ReasoningLease",
            "RuntimeAttestation"
          ]
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "record_hash",
        "canonical_record_json"
      ],
      "type": "object"
    },
    "capabilityBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_calls": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_cost_microunits": {
          "maximum": 1000000000000,
          "minimum": 0,
          "type": "integer"
        },
        "maximum_tokens": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximum_calls",
        "maximum_cost_microunits",
        "maximum_tokens"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "constitution_hash": {
          "$ref": "#/$defs/digest"
        },
        "identity_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "identity_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "identity_id",
        "identity_revision",
        "identity_epoch",
        "constitution_hash"
      ],
      "type": "object"
    },
    "installation": {
      "additionalProperties": false,
      "properties": {
        "embodiment": {
          "enum": [
            "server-sentinel",
            "mac-engineer"
          ]
        },
        "host_class": {
          "enum": [
            "near-platform-server",
            "local-mac"
          ]
        },
        "installation_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "installation_id",
        "embodiment",
        "host_class"
      ],
      "type": "object"
    },
    "reasoningCasPrecondition": {
      "additionalProperties": false,
      "properties": {
        "expected_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "identity_id",
        "scope_type",
        "scope_id",
        "expected_generation",
        "expected_active_reasoning_lease_hash"
      ],
      "type": "object"
    },
    "reasoningCasResult": {
      "additionalProperties": false,
      "properties": {
        "committed_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "committed_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "identity_id": {
          "$ref": "#/$defs/identifier"
        },
        "previous_active_reasoning_lease_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "identity_id",
        "scope_type",
        "scope_id",
        "previous_generation",
        "committed_generation",
        "previous_active_reasoning_lease_hash",
        "committed_active_reasoning_lease_hash"
      ],
      "type": "object"
    },
    "recordCommit": {
      "additionalProperties": false,
      "properties": {
        "append_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "record_hash": {
          "$ref": "#/$defs/digest"
        },
        "record_id": {
          "$ref": "#/$defs/uuid"
        },
        "record_kind": {
          "enum": [
            "AgentConstitution",
            "AgentEpisode",
            "AgentHandoff",
            "AgentIdentityDescriptor",
            "AgentIdentityRevision",
            "CapabilityCandidate",
            "CapabilityEvaluation",
            "CapabilityGap",
            "CapabilityInvocation",
            "CapabilityLease",
            "CapabilityPromotion",
            "CapabilityRevocation",
            "FoundryAdmissionAttestation",
            "KnowledgeClaim",
            "ReasoningLease",
            "RuntimeAttestation"
          ]
        }
      },
      "required": [
        "record_id",
        "record_kind",
        "record_hash",
        "append_sequence"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_type": {
          "$ref": "#/$defs/identifier"
        },
        "scope_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope_type": {
          "enum": [
            "installation",
            "incident",
            "journey",
            "task"
          ]
        }
      },
      "required": [
        "scope_type",
        "scope_id",
        "installation_id",
        "resource_type",
        "resource_id"
      ],
      "type": "object"
    },
    "scopeBinding": {
      "additionalProperties": false,
      "properties": {
        "record_hashes": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "runtime_attestation_hashes": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      },
      "required": [
        "scope",
        "runtime_attestation_hashes",
        "record_hashes"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.masonjames.dev/platform-steward/chronicle/v1/chronicle-append-disposition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "platform.masonjames.dev/steward-chronicle/v1"
    },
    "authority_effect": {
      "const": "none"
    },
    "chronicle_id": {
      "$ref": "#/$defs/identifier"
    },
    "decision_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "disposition": {
      "const": "rejected"
    },
    "disposition_digest": {
      "$ref": "#/$defs/digest"
    },
    "disposition_id": {
      "$ref": "#/$defs/uuid"
    },
    "evidence_accepted": {
      "const": false
    },
    "issuer": {
      "$ref": "#/$defs/identifier"
    },
    "issuer_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "kind": {
      "const": "ChronicleAppendDisposition"
    },
    "record_committed": {
      "const": false
    },
    "rejection_reason": {
      "enum": [
        "expired_request",
        "future_request",
        "writer_sequence_conflict",
        "previous_envelope_mismatch",
        "identity_mismatch",
        "audience_mismatch",
        "installation_mismatch",
        "mode_mismatch",
        "scope_binding_mismatch",
        "budget_exceeded",
        "evidence_unavailable",
        "source_attestation_invalid",
        "record_invalid",
        "replay_conflict",
        "cas_conflict",
        "chronicle_rejected",
        "authority_changed",
        "trusted_clock_rollback",
        "internal_failure"
      ]
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "signature_bundle_hash": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "disposition_id",
    "request_id",
    "request_digest",
    "chronicle_id",
    "disposition",
    "rejection_reason",
    "decision_at",
    "evidence_accepted",
    "record_committed",
    "authority_effect",
    "issuer",
    "issuer_key_id",
    "disposition_digest",
    "signature_bundle_hash"
  ],
  "title": "ChronicleAppendDisposition",
  "type": "object"
}
